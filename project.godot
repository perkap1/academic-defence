; Academic Defence — Godot 4.4+
config_version=5

[application]
config/name="Academic Defence"
config/version="0.009.2"
config/icon="res://assets/ui/icon_reputation.png"
boot_splash/image="res://assets/ui/icon_reputation.png"
boot_splash/bg_color=Color(0.035, 0.07, 0.08, 1)
run/main_scene="res://scenes/world_map.tscn"

[display]
